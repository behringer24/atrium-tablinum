# Copy to .env and fill in. .env does not belong in the repository.
# Any strong password, letters and digits only (it ends up in a URL): openssl rand -hex 24
# Applies from the first start of the database. A later change here does not change the password there.
POSTGRES_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public HTTPS address of this instance (what Claude and ChatGPT see), no trailing slash.
ATRIUM_BASE_URL=https://knowledge.example.com
# E-mail domain whose accounts may log in. For private accounts use allowed_emails in config.yaml.
ATRIUM_ALLOWED_DOMAIN=example.com
# E-mail of the first instance admin.
ADMIN_EMAIL=
# Names of this instance, read on the first start only (afterwards an instance admin changes them
# with admin_instance). Useful when one assistant is connected to several Atrium instances.
# ATRIUM_SHORT_NAME=Atrium
# ATRIUM_ORGANIZATION_NAME=Example Corp
# Configuration file other than ./config.yaml (e.g. a separate one for Docker).
# CONFIG_FILE=./config.docker.yaml
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Embedding backend openai: key; backend bedrock: AWS access (on ECS/EC2 the IAM role is enough).
# EMBEDDING_API_KEY=
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Start arguments of the TEI server; for servers with 4 GB RAM:
# TEI_ARGS=--model-id BAAI/bge-m3 --max-batch-tokens 1024 --auto-truncate

# Variant B/C: interface on which the server is reachable on the host.
# SERVER_BIND=127.0.0.1:8080
# Variant A only (--profile proxy):
# DOMAIN=knowledge.example.com
# LETSENCRYPT_EMAIL=admin@example.com
