# Nach .env kopieren und ausfüllen. .env gehört nicht ins Repository.
# Beliebiges starkes Passwort, nur Buchstaben und Ziffern (es steht in einer URL): openssl rand -hex 24
# Gilt ab dem ersten Start der Datenbank. Eine spätere Änderung hier ändert das Passwort dort nicht.
POSTGRES_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-Mail des ersten Admins, falls config.yaml sie als ${ADMIN_EMAIL} referenziert.
# ADMIN_EMAIL=
# Andere Konfigurationsdatei als ./config.yaml (z. B. eine eigene für Docker).
# CONFIG_FILE=./config.docker.yaml
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Embedding-Backend openai: Schlüssel; Backend bedrock: AWS-Zugang (auf ECS/EC2 genügt die IAM-Rolle).
# EMBEDDING_API_KEY=
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Startargumente des TEI-Servers; für Server mit 4 GB RAM:
# TEI_ARGS=--model-id BAAI/bge-m3 --max-batch-tokens 1024 --auto-truncate

# Variante B/C: Schnittstelle, auf der der Server auf dem Host erreichbar ist.
# SERVER_BIND=127.0.0.1:8080
# Nur Variante A (--profile proxy):
# DOMAIN=knowledge.example.com
# LETSENCRYPT_EMAIL=admin@example.com
